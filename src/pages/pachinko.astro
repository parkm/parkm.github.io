---
export const title = "Pachinko";
export const description = "A peg shooter with a talent tree and a shot finder";
export const icon = CircleDot;
export const category = "Entertainment";

import { CircleDot } from "lucide-react";
import Layout from "../layouts/Layout.astro";
---

<Layout title={title} description={description} disableZoom={true} themeColor="#0c0e16">
  <div id="pk-root" class="pk-root">
    <header class="pk-top">
      <div class="pk-top-left">
        <span id="pk-board" class="pk-board-title"></span>
        <span class="pk-level-wrap">
          <span id="pk-level"></span>
          <span class="pk-xp-track"><span id="pk-xp" class="pk-xp"></span></span>
        </span>
      </div>
      <div id="pk-score" class="pk-score" aria-label="Score">0</div>
      <div class="pk-top-right">
        <span class="pk-stat"><span class="pk-swatch"></span><span id="pk-targets"></span></span>
        <span id="pk-mult" class="pk-stat pk-mult"></span>
      </div>
    </header>

    <div class="pk-stage">
      <canvas id="pk-canvas" class="pk-canvas"></canvas>
      <div id="pk-note" class="pk-note" role="status"></div>
    </div>

    <nav class="pk-bar">
      <button id="pk-boards" type="button" class="pk-btn">Boards</button>
      <button id="pk-talents" type="button" class="pk-btn">
        Talents<span id="pk-points" class="pk-badge" hidden></span>
      </button>
      <button id="pk-foresight" type="button" class="pk-btn pk-btn-foresight">
        Foresight<span id="pk-charges" class="pk-count"></span>
      </button>
      <button id="pk-mute" type="button" class="pk-btn pk-btn-quiet"></button>
    </nav>

    <div id="pk-overlay" class="pk-overlay" hidden>
      <div id="pk-panel" class="pk-panel" role="dialog" aria-modal="true"></div>
    </div>
  </div>

  <script>
    import { startPachinko } from "@/components/Pachinko/game";

    startPachinko(document.getElementById("pk-root")!);
  </script>
</Layout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: #0c0e16;
  }

  .pk-root {
    --pk-ink: #e9eef7;
    --pk-dim: #8c96b3;
    --pk-line: rgba(143, 163, 217, 0.22);
    --pk-panel: #171b2c;
    --pk-gold: #ffd27a;
    --pk-cyan: #7fe9ff;
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    color: var(--pk-ink);
    font-family: system-ui, sans-serif;
    font-size: 14px;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .pk-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
    padding: 0.5rem 0.75rem 0.25rem;
    padding-top: max(0.5rem, env(safe-area-inset-top));
  }

  .pk-top-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .pk-board-title {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pk-level-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--pk-dim);
    font-size: 12px;
  }

  .pk-xp-track {
    width: 4.5rem;
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--pk-line);
  }

  .pk-xp {
    display: block;
    height: 100%;
    background: var(--pk-gold);
  }

  .pk-score {
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .pk-top-right {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .pk-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .pk-swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #e8922e;
  }

  .pk-mult {
    color: var(--pk-gold);
  }

  .pk-stage {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .pk-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: none;
  }

  .pk-note {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 0 1rem;
    color: var(--pk-cyan);
    font-weight: 600;
    text-align: center;
    text-shadow: 0 1px 6px #0c0e16, 0 0 2px #0c0e16;
    pointer-events: none;
  }

  .pk-bar {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
  }

  .pk-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border: 1px solid var(--pk-line);
    border-radius: 0.5rem;
    background: #1c2238;
    color: var(--pk-ink);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .pk-btn:hover:not(:disabled) {
    background: #252c47;
  }

  .pk-btn:focus-visible,
  .pk-node:focus-visible,
  .pk-icon-btn:focus-visible,
  .pk-board-row:focus-visible {
    outline: 2px solid var(--pk-cyan);
    outline-offset: 2px;
  }

  .pk-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .pk-btn-quiet {
    background: transparent;
    color: var(--pk-dim);
  }

  .pk-btn-main {
    border-color: transparent;
    background: var(--pk-gold);
    color: #2a1c00;
  }

  .pk-btn-main:hover:not(:disabled) {
    background: #ffe0a3;
  }

  .pk-btn-foresight {
    border-color: rgba(127, 233, 255, 0.45);
    color: var(--pk-cyan);
  }

  .pk-count {
    min-width: 1.3rem;
    padding: 0.05rem 0.3rem;
    border-radius: 0.3rem;
    background: rgba(127, 233, 255, 0.16);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .pk-badge {
    min-width: 1.2rem;
    padding: 0.05rem 0.3rem;
    border-radius: 999px;
    background: var(--pk-gold);
    color: #2a1c00;
    font-size: 12px;
    text-align: center;
  }

  .pk-overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    background: rgba(6, 8, 14, 0.72);
  }

  .pk-overlay[hidden] {
    display: none;
  }

  .pk-panel {
    width: max-content;
    max-width: 100%;
    max-height: 100%;
    overflow: auto;
    padding: 0.85rem;
    border: 1px solid var(--pk-line);
    border-radius: 0.85rem;
    background: var(--pk-panel);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .pk-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .pk-panel-head h2 {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .pk-icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
    color: var(--pk-dim);
    cursor: pointer;
  }

  .pk-icon-btn:hover {
    background: #252c47;
    color: var(--pk-ink);
  }

  .pk-dim {
    color: var(--pk-dim);
  }

  .pk-gold {
    color: var(--pk-gold);
  }

  .pk-warn {
    color: #ff8f8f;
  }

  /* Talents */

  .pk-talent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .pk-trees {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .pk-tree {
    padding: 0.5rem 0.4rem 0.6rem;
    border: 1px solid var(--pk-line);
    border-radius: 0.6rem;
    background: #11141f;
  }

  .pk-tree h3 {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    font-size: 13px;
    font-weight: 700;
  }

  .pk-tree h3 span {
    color: var(--pk-dim);
    font-variant-numeric: tabular-nums;
  }

  .pk-tree-grid {
    position: relative;
    margin: 0 auto;
  }

  .pk-node {
    position: absolute;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 2px solid #343c57;
    border-radius: 8px;
    background: #1c2238;
    color: #5d678a;
    cursor: pointer;
  }

  .pk-node svg {
    width: 24px;
    height: 24px;
  }

  .pk-node[data-state="idle"] {
    color: #aab4d4;
  }

  .pk-node[data-state="open"] {
    border-color: #5fd08a;
    color: var(--pk-ink);
  }

  .pk-node[data-state="learned"] {
    border-color: #5fd08a;
    background: #1d3340;
    color: var(--pk-ink);
  }

  .pk-node[data-state="max"] {
    border-color: var(--pk-gold);
    background: #3a2f18;
    color: var(--pk-gold);
  }

  .pk-node[data-selected="true"] {
    box-shadow: 0 0 0 2px rgba(233, 238, 247, 0.55);
  }

  .pk-rank {
    position: absolute;
    right: -6px;
    bottom: -7px;
    padding: 0 3px;
    border-radius: 4px;
    background: #0c0e16;
    color: var(--pk-ink);
    font-size: 10px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 14px;
  }

  .pk-node[data-state="locked"] .pk-rank {
    color: var(--pk-dim);
  }

  .pk-arrow {
    position: absolute;
    width: 3px;
    background: #343c57;
  }

  .pk-arrow::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: -3.5px;
    border: 5px solid transparent;
    border-top-color: #343c57;
    border-bottom-width: 0;
  }

  .pk-arrow[data-met="true"] {
    background: var(--pk-gold);
  }

  .pk-arrow[data-met="true"]::after {
    border-top-color: var(--pk-gold);
  }

  .pk-tip {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    width: 0;
    min-width: 100%;
    /* Fixed, so the panel doesn't resize as different talents are shown. */
    height: 10.75rem;
    overflow: hidden;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pk-line);
  }

  .pk-tip-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    line-height: 1.35;
  }

  .pk-tip-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 700;
  }

  .pk-tip-title span {
    color: var(--pk-dim);
    font-size: 12px;
    font-weight: 500;
  }

  .pk-tip-actions {
    display: flex;
    gap: 0.4rem;
  }

  .pk-tip-actions .pk-btn {
    width: 2.5rem;
    padding: 0;
    font-size: 1.2rem;
  }

  /* Boards and results */

  .pk-boards {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 18rem;
    max-width: 100%;
  }

  .pk-board-row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--pk-line);
    border-radius: 0.5rem;
    background: #1c2238;
    text-align: left;
    cursor: pointer;
  }

  .pk-board-row:hover:not(:disabled) {
    background: #252c47;
  }

  .pk-board-row:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .pk-board-row[data-current="true"] {
    border-color: var(--pk-gold);
  }

  .pk-board-num {
    color: var(--pk-dim);
    font-variant-numeric: tabular-nums;
  }

  .pk-board-name {
    font-weight: 600;
  }

  .pk-boards-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pk-line);
  }

  .pk-boards-footer p {
    flex-basis: 100%;
    line-height: 1.35;
  }

  .pk-btn-danger {
    border-color: transparent;
    background: #c93f3f;
    color: #fff;
  }

  .pk-btn-danger:hover:not(:disabled) {
    background: #dd5151;
  }

  .pk-results {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 17rem;
    max-width: 100%;
  }

  .pk-results-score {
    font-size: 2.4rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .pk-results-rows {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
  }

  .pk-results-rows dt {
    color: var(--pk-dim);
  }

  .pk-results-rows dd {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .pk-results-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  @media (max-width: 420px) {
    .pk-btn {
      padding: 0 0.6rem;
    }

    .pk-score {
      font-size: 1.35rem;
    }
  }
</style>
