---
import ArchivoFont from "../components/ArchivoFont.astro";
import Layout from "../layouts/Layout.astro";
import CanopyLogo from "../components/CanopyLogo.astro";
import InstructureLogo from "../components/InstructureLogo.astro";
import * as profile from "@/content/profile.md";
import { facts, homeJsonLd, toScriptJson } from "@/lib/content";

// Each `### Company` section in profile.md becomes a work row.
const LOGOS: Record<string, typeof CanopyLogo> = {
  Canopy: CanopyLogo,
  Instructure: InstructureLogo,
};

const html = await profile.compiledContent();
const [intro, ...sections] = html.split(/(?=<h3[\s>])/);
let outro = "";
const jobs = sections.map((section, i) => {
  const [, heading, rest] = section.match(
    /^<h3[^>]*>([\s\S]*?)<\/h3>([\s\S]*)$/,
  )!;
  const [body, after = ""] =
    i === sections.length - 1 ? rest.split(/(?=<h2[\s>])/) : [rest];
  outro = after;
  const name = heading.replace(/<[^>]+>/g, "").trim();
  return { name, Logo: LOGOS[name], body };
});
---

<Layout title={facts.title} description={facts.description} themeColor="#f3f5f2">
  <ArchivoFont slot="head" />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={toScriptJson(homeJsonLd())}
  />
  <link slot="head" rel="alternate" type="text/markdown" href="/index.md" />

  <canvas id="light" class="light" aria-hidden="true"></canvas>

  <a class="map-link" href="/map" aria-label="Site map">
    <svg viewBox="0 0 10 10" width="12" height="12" aria-hidden="true">
      {
        [1, 5, 9].flatMap((y) =>
          [1, 5, 9].map((x) => <circle cx={x} cy={y} r="1" />),
        )
      }
    </svg>
  </a>

  <main class="page">
    <div class="intro" set:html={intro} />

    {
      jobs.length > 0 && (
        <ol class="jobs" role="list">
          {jobs.map(({ name, Logo, body }) => (
            <li class="job">
              <h3 class="job-name">
                {Logo ? (
                  <>
                    <Logo class="logo" aria-hidden="true" />
                    <span class="sr-only">{name}</span>
                  </>
                ) : (
                  name
                )}
              </h3>
              <div class="job-body" set:html={body} />
            </li>
          ))}
        </ol>
      )
    }

    {outro && <div class="outro" set:html={outro} />}
  </main>

  <footer class="footer">
    <span>© {new Date().getFullYear()} {facts.name}</span>
  </footer>
</Layout>

<style>
  :global(html) {
    --home-paper: oklch(0.966 0.006 150);
    --home-ink: oklch(0.21 0.016 160);
    --home-muted: oklch(0.47 0.014 160);
    --home-rule: oklch(0.21 0.016 160 / 0.12);
    background: var(--home-paper);
    color: var(--home-ink);
    font-family: "Archivo Variable", system-ui, sans-serif;
    font-stretch: 100%;
    -webkit-font-smoothing: antialiased;
  }

  :global(html.dark) {
    --home-paper: oklch(0.19 0.012 240);
    --home-ink: oklch(0.92 0.008 220);
    --home-muted: oklch(0.68 0.012 220);
    --home-rule: oklch(0.92 0.008 220 / 0.12);
    color-scheme: dark;
  }

  :global(body) {
    background: var(--home-paper);
    color: var(--home-ink);
  }

  /* Multiply darkens the paper in light mode; screen lightens it in dark mode. */
  /* Sized to the large viewport so mobile toolbar show/hide doesn't resize
     (and clear) the canvas mid-scroll. */
  .light {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 100%;
    height: 100lvh;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }

  :global(html.dark) .light {
    mix-blend-mode: screen;
  }

  .light:global(.is-live) {
    opacity: 1;
  }

  .page {
    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(4rem, 14vh, 9rem) 1.25rem 0;
  }

  @media (min-width: 640px) {
    .page {
      padding-inline: 2.5rem;
    }
  }

  .intro :global(h1) {
    font-size: clamp(3rem, 11vw, 8.5rem);
    font-stretch: 118%;
    font-weight: 760;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .intro :global(p) {
    max-width: 34rem;
    margin-top: 1.75rem;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .intro :global(p + p) {
    margin-top: 1rem;
  }

  .intro :global(h2),
  .outro :global(h2) {
    margin: clamp(5rem, 14vh, 8rem) 0 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--home-rule);
    font-size: 0.9375rem;
    font-stretch: 112%;
    font-weight: 600;
    color: var(--home-muted);
  }

  .page :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in oklch, currentColor 35%, transparent);
  }

  /* Icons for profile links, keyed off the URL. */
  .page :global(a[href*="github.com"]),
  .page :global(a[href*="linkedin.com"]) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .page :global(a[href*="github.com"])::before,
  .page :global(a[href*="linkedin.com"])::before {
    content: "";
    width: 0.95em;
    height: 0.95em;
    background: currentColor;
    mask: var(--icon) center / contain no-repeat;
  }

  .page :global(a[href*="github.com"]) {
    --icon: url("/icons/github.svg");
  }

  .page :global(a[href*="linkedin.com"]) {
    --icon: url("/icons/linkedin.svg");
  }

  @media (hover: hover) {
    .page :global(a:hover) {
      text-decoration-color: currentColor;
    }
  }

  .page :global(a:focus-visible),
  .map-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .jobs {
    list-style: none;
  }

  .job {
    display: grid;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--home-rule);
  }

  @media (min-width: 860px) {
    .job {
      grid-template-columns: 18rem minmax(0, 40rem);
      gap: 3rem;
      padding: 3.5rem 0;
    }
  }

  .job-name {
    font-size: 1.25rem;
    font-stretch: 112%;
    font-weight: 650;
  }

  .job-name :global(.logo) {
    display: block;
    width: auto;
    height: 1.75rem;
    max-width: 100%;
    filter: brightness(0);
    opacity: 0.86;
  }

  :global(html.dark) .job-name :global(.logo) {
    filter: brightness(0) invert(1);
  }

  .job-body {
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Role title, then its dates. */
  .job-body :global(h4) {
    margin-top: 2rem;
    font-stretch: 108%;
    font-weight: 600;
  }

  .job-body > :global(h4:first-child) {
    margin-top: 0;
  }

  .job-body :global(h4 + p) {
    margin: 0.125rem 0 0.75rem;
    color: var(--home-muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .job-body :global(h4 + p + p) {
    margin-top: 0;
  }

  .job-body :global(p + p) {
    margin-top: 0.875rem;
  }

  .outro :global(p) {
    max-width: 40rem;
    margin-top: 1rem;
    line-height: 1.6;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 4rem 1.25rem 2.5rem;
    color: var(--home-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .footer {
      padding-inline: 2.5rem;
    }
  }

  .map-link {
    position: fixed;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    fill: currentColor;
    opacity: 0.3;
  }

  .map-link:hover,
  .map-link:focus-visible {
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    .light {
      display: none;
    }
  }
</style>

<script>
  import { startDappleLight } from "@/components/Dapple/dappleLight";

  startDappleLight(document.querySelector<HTMLCanvasElement>("#light")!);
</script>
